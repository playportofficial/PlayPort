{
  "name": "playport",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "postinstall": "npm --prefix functions ci",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "vercel-build": "expo export -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "functions:build": "npm --prefix functions run build",
    "firebase:seed": "tsx scripts/seedFirestore.ts",
    "firebase:seed:admin": "tsx scripts/seedAdmin.ts",
    "firebase:seed:rest": "tsx scripts/seedRest.ts",
    "firebase:wipe:catalog": "tsx scripts/wipeCatalog.ts",
    "firebase:admin:claim": "tsx scripts/setAdminClaim.ts",
    "firebase:backfill:contacts": "tsx scripts/backfillOrderContacts.ts",
    "firebase:deploy": "npx -y firebase-tools@latest deploy --only firestore,auth --project playport-fd57f",
    "firebase:deploy:firestore": "npx -y firebase-tools@latest deploy --only firestore --project playport-fd57f",
    "firebase:deploy:functions": "npm --prefix functions run build && npx -y firebase-tools@latest deploy --only functions --project playport-fd57f",
    "firebase:deploy:all": "npm --prefix functions run build && npx -y firebase-tools@latest deploy --only firestore,auth,functions --project playport-fd57f",
    "firebase:emulators": "npm --prefix functions run build && npx -y firebase-tools@latest emulators:start --only auth,firestore,functions --project playport-fd57f"
  },
  "private": true
}
